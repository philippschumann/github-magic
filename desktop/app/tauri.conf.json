{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Github Magic",
  "identifier": "com.philippschumann.github-magic",
  "build": {
    "beforeDevCommand": {
      "script": "cargo build -p github-magic-bridge",
      "wait": true
    },
    "beforeBuildCommand": "cargo build --release -p github-magic-bridge",
    "frontendDist": "../../settings"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [],
    "security": {
      "csp": "default-src 'self'; connect-src ipc: http://ipc.localhost"
    }
  },
  "bundle": {
    "active": true,
    "targets": [
      "app"
    ],
    "macOS": {
      "signingIdentity": "-",
      "files": {
        "MacOS/github-magic-bridge": "../target/release/github-magic-bridge"
      }
    }
  }
}
